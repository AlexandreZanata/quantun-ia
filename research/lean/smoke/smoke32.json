{
  "schema_version": 1,
  "name": "ltp00-smoke32",
  "purpose": "Conjunto smoke congelado do LTP-00: 32 afirmações Lean 4 provadas com táticas disponíveis em Mathlib.Tactic. Sem sobreposição com miniF2F, ProofNet, miniCTX, PutnamBench ou LeanDojo.",
  "imports": [
    "Mathlib.Tactic"
  ],
  "policy": {
    "allowed_axioms": [
      "propext",
      "Classical.choice",
      "Quot.sound"
    ],
    "forbidden_tokens": [
      "sorry",
      "admit",
      "sorryAx",
      "axiom",
      "constant",
      "unsafe",
      "run_tac",
      "run_cmd",
      "set_option",
      "partial",
      "#eval",
      "#exec"
    ],
    "timeout_seconds": 120,
    "max_heartbeats": 200000,
    "statement_hash": "sha256 do texto da afirmação em NFC, comentários removidos e espaços colapsados"
  },
  "theorems": [
